# include <stdio.h>

void main(){

    int   cdocu = 0, cima = 0, cvide = 0, cprod = 0;
    float tadocu =0.00, taima = 0.00, tavide = 0.00, taprog = 0.00, td = 0.00, ti = 0.00, tv = 0.00, tpro = 0.00, etGB = 0.00, etu = 0.00, por = 0.00, cdGB = 0.00;

    printf("Ingrese la cantidad de documentos que tiene: ");
    scanf("%d", &cdocu);
    printf("Ingrese la cantidad de imagenes que tiene: ");
    scanf("%d", &cima);
    printf("Ingrese la cantidad de videos que tiene: ");
    scanf("%d", &cvide);
    printf("Ingrese la cantidad de programas que tiene: ");
    scanf("%d", &cprod);
    printf("Ingrese la capacidad de almacenamiento del disco (GB): ");
    scanf("%f", &cdGB);
    printf("Ingrese el tamano de los documento en (MB): ");
    scanf("%f", &tadocu);
    printf("Ingrese el tamano de las imagenes en (MB): ");
    scanf("%f", &taima);
    printf("Ingrese el tamano de los videos en (MB): ");
    scanf("%f", &tavide);
    printf("Ingrese el tamano de los programas en (MB): ");
    scanf("%f", &taprog);

    td = cdocu * tadocu;
    ti = cima * taima;
    tv = cvide * tavide;
    tpro = cprod * taprog;
    etGB = (td + ti + tv + tpro) / 1024;
    por = etGB / cdGB * 100;
    etu = cdGB - etGB;

    printf("El espacio utilizado es: %.2f GB\n", etGB);
    printf("El porcentaje de uso es: %.2f%%\n", por);
    printf("El espacio disponible es: %.2f GB\n", etu);


}
