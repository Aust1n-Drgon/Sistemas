#include <stdio.h>
#include <math.h>

int main() {
    float l1 = 0.0f;
    float l2 = 0.0f;
    float l3 = 0.0f;
    float peri = 0.0f;
    float res_di = 0.0f;
    int equi = 0;

    printf("[ENTRADA] Ingrese la longitud del lado 1: ");
    scanf("%f", &l1);
    printf("[ENTRADA] Ingrese la longitud del lado 2: ");
    scanf("%f", &l2);
    printf("[ENTRADA] Ingrese la longitud del lado 3: ");
    scanf("%f", &l3);

    peri = l1 + l2 + l3;
    res_di = fmodf(peri, 2.0f);

    if ((l1 == l2) && (l2 == l3)) {
        equi = 1;
    }

    printf("\n-------------------- INFORMACION DE SALIDA --------------------\n");
    printf("Lados ingresados: Lado 1 = %.2f, Lado 2 = %.2f, Lado 3 = %.2f\n", l1, l2, l3);
    printf("Perimetro total calculado: %.2f\n", peri);
    
    if (equi == 1) {
        printf("Resultado: El triangulo ES equilatero.\n");
    } 
    else {
        printf("Resultado: El triangulo NO es equilatero.\n");
    }
    
    printf("Valor de la variable booleana (es_equilatero): %d\n", equi);
    printf("Resto de la division adicional (perimetro %% 2.0): %.2f\n", res_di);
    printf("---------------------------------------------------------------\n");
    printf("\n[INFO]: Proceso completado exitosamente en el sistema escolar.\n");

    return 0;
}
